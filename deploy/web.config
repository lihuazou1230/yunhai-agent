<?xml version="1.0" encoding="utf-8"?>
<!--
  云海工作台 · Agent 后端在 IIS 下的反代配置（同源子应用 /yhai，复用 80 端口）
  ==========================================================================
  这个文件由 deploy\install.ps1 渲染后放进子应用的物理目录（默认 C:\inetpub\wwwroot\yhai\），
  里面只放它一个文件：应用本体、venv、.env 都在站点外的 C:\yunhai-agent，静态处理器够不着。

  占位符：__AGENT_PORT__（agent 监听的端口，默认 8000）

  为什么是 ARR 反代而不是 HttpPlatformHandler
  ==========================================
  HttpPlatformHandler v1.2 自带 **8KB 输出缓冲且无法关闭**（微软从未发布修好的 v1.3），
  拿来扛 SSE 的结果就是"回答憋到最后一次性吐"——而我们最不能丢的就是逐字吐。
  在 handler 上加 responseBufferLimit="0" 只能关掉 IIS 那层 4MB 缓冲，关不掉模块内部那 8KB。
  ARR 的响应缓冲是**可配置**的（机器级 minResponseBuffer=0，见 install.ps1），所以选它。

  规则写在 /yhai 应用自己的 web.config 里，好处是隔离：不动站点根，也就碰不到 /workspace/。
  注意 URL Rewrite 的 <match url> 是**相对规则所在 web.config** 的路径（官方文档原文），
  所以这里是 ^(.*) 而不是 ^yhai/(.*)；若哪天挪到站点根，模式必须改成 ^yhai/(.*)。
-->
<configuration>
  <system.webServer>

    <rewrite>
      <rules>
        <!-- stopProcessing：命中后不再走静态文件处理，直接交给 ARR 转出去 -->
        <rule name="yhai-reverse-proxy" stopProcessing="true">
          <match url="^(.*)" />
          <!-- 显式剥掉 /yhai 前缀：应用内相对路径 api/health → http://127.0.0.1:8000/api/health -->
          <action type="Rewrite" url="http://127.0.0.1:__AGENT_PORT__/{R:1}" />
        </rule>
      </rules>
    </rewrite>

    <!--
      动态压缩必须关：压缩器要攒够数据才压，SSE 的分块会被它聚成一坨。
      静态压缩留着无妨（本应用没有静态文件）。
    -->
    <urlCompression doStaticCompression="true" doDynamicCompression="false" />

    <!-- 输出缓存 / 内核缓存同样会把流式响应攒起来 -->
    <caching enabled="false" enableKernelCache="false" />

    <!--
      让后端返回的 JSON 错误原样透传。默认 Auto 会用 IIS 自己的 HTML 错误页盖掉 4xx/5xx，
      前端就看不到"库里没有的问题直接拒答"这类提示了。
    -->
    <httpErrors existingResponse="PassThrough" />

    <directoryBrowse enabled="false" />

    <security>
      <requestFiltering>
        <!-- 前端限制 10MB，这里给到 200MB 余量（默认 30MB 也够，写死免得站点级被调小） -->
        <requestLimits maxAllowedContentLength="209715200" />
      </requestFiltering>
    </security>

  </system.webServer>
</configuration>
