# ============ 云海工作台 · Agent 后端配置（第十阶段：RAG 知识库）============
# 复制成 .env 再填。.env 已在 .gitignore 里：**Key 永不进 Git、永不进前端**。

# ---------- 生成侧（OpenAI 兼容；默认 DeepSeek）----------
# 申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ---------- 向量化 ----------
# bge：本地中文语义模型（推荐，需 sentence-transformers）
# hash：零依赖兜底（跑测试/没下模型时用）
# api：OpenAI 兼容 /embeddings（例如 SiliconFlow 的 BAAI/bge-m3）
EMBEDDER=bge
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 走 hf-mirror 预先下载到本地的目录（存在就直接用，不联网）
EMBED_LOCAL_DIR=models/bge-small-zh-v1.5
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=16
# EMBEDDER=api 时才需要
EMBED_API_KEY=
EMBED_API_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_MODEL=BAAI/bge-m3
HASH_EMBED_DIM=512

# ---------- 检索（阈值由 scripts/eval_retrieval.py 用库内/库外问题集校准）----------
COLLECTION=yunhai_knowledge
TOP_K=4
SCORE_THRESHOLD=0.4
LEXICAL_SCORE_THRESHOLD=0.55
MIN_HITS=1
# 兜底三模式：refuse（默认拒答）/ bare（裸答并标注）/ web（联网搜索，阶段后置）
FALLBACK_MODE=refuse

# ---------- 分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- HTTP ----------
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://tauri.localhost,tauri://localhost
