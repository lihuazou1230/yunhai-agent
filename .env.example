# ============ 云海工作台 · Agent 后端配置（第十阶段：RAG 知识库）============
# 复制成 .env 再填。.env 已在 .gitignore 里：**Key 永不进 Git、永不进前端**。

# ---------- 生成侧（OpenAI 兼容；默认 DeepSeek）----------
# 申请：https://platform.deepseek.com/api_keys
LLM_API_KEY=
LLM_BASE_URL=https://api.deepseek.com/v1
LLM_MODEL=deepseek-chat
LLM_TIMEOUT_S=60
LLM_MAX_TOKENS=1024
LLM_TEMPERATURE=0.2

# ---------- 向量化 ----------
# bge：本地中文语义模型（推荐，需 sentence-transformers）
# hash：零依赖兜底（跑测试/没下模型时用）
# api：OpenAI 兼容 /embeddings（例如 SiliconFlow 的 BAAI/bge-m3）
EMBEDDER=bge
EMBED_MODEL=BAAI/bge-small-zh-v1.5
# 走 hf-mirror 预先下载到本地的目录（存在就直接用，不联网）
EMBED_LOCAL_DIR=models/bge-small-zh-v1.5
EMBED_DEVICE=cpu
EMBED_BATCH_SIZE=16
# EMBEDDER=api 时才需要
EMBED_API_KEY=
EMBED_API_BASE_URL=https://api.siliconflow.cn/v1
EMBED_API_MODEL=BAAI/bge-m3
HASH_EMBED_DIM=512

# ---------- 检索（阈值由 scripts/eval_retrieval.py 用库内/库外问题集校准）----------
COLLECTION=yunhai_knowledge
TOP_K=4
SCORE_THRESHOLD=0.4
LEXICAL_SCORE_THRESHOLD=0.55
MIN_HITS=1
# 兜底三模式：refuse（默认拒答）/ bare（裸答并标注）/ web（联网搜索，阶段后置）
FALLBACK_MODE=refuse

# ---------- Agent 内核（第十一阶段：ReAct 循环与护栏）----------
# 护栏三件套：轮数上限 + token 预算 + 工具超时；外加「同一工具连续失败几次就熔断」
AGENT_MAX_ROUNDS=8
AGENT_TOKEN_BUDGET=12000
AGENT_TOOL_TIMEOUT_S=10
AGENT_RUN_TIMEOUT_S=120
AGENT_MAX_TOOL_FAILURES=3
# 回填给模型的历史消息条数（已剔除轻量闲聊）
AGENT_HISTORY_MESSAGES=6
# 等前端执行 client 工具的待续跑状态保留多久（秒）
AGENT_RUN_TTL_S=3600

# ---------- 分块 ----------
CHUNK_SIZE=500
CHUNK_OVERLAP=80

# ---------- HTTP ----------
# 跨域白名单：origin 只到「协议+主机+端口」，写带路径的地址永远匹配不上。
# 部署页（http://124.220.159.58/workspace/）要直连某个 agent，就把那个 agent 所在站的 origin 加进来。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173,http://127.0.0.1:4173,http://tauri.localhost,tauri://localhost,http://124.220.159.58

# ---------- 挂在子路径下（服务器形态）----------
# 空 = 不剥前缀（本地开发，或代理已经帮你剥过前缀）。
# 设成 /yhai 表示"我被挂在 IIS 子应用 /yhai 下"：进来的 /yhai/api/health 先剥成 /api/health 再进路由。
# 为什么需要：IIS 的 HttpPlatformHandler 把请求**原样**转给子进程（ARR 反代则会剥掉前缀），
# 两种托管方式都兼容 —— 已经剥过的路径在这里是空操作。
# 注意环境变量名就是 AGENT_URL_PREFIX（pydantic-settings 按**字段名**推名，写成 URL_PREFIX 会静默失效）。
AGENT_URL_PREFIX=
